# ─────────────────────────────────────────────
# IQAC Data Automation Platform — Environment
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Environment
ENVIRONMENT=development

# Database
POSTGRES_USER=iqac_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=iqac_db

# Security — generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_real_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Redis
REDIS_URL=redis://redis:6379/0

# AI (optional — leave blank to disable AI features)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI Natural Language Search (Module 6)
AI_PROVIDER=openai          # "openai" or "ollama"
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_OLLAMA=llama3.1
AI_SQL_ROW_LIMIT=500
AI_QUERY_TIMEOUT_SECONDS=15

# RAG Chatbot (Module 7)
RAG_EMBEDDING_MODEL_OPENAI=text-embedding-3-small
RAG_EMBEDDING_MODEL_OLLAMA=nomic-embed-text
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_FILE_SIZE_MB=50

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=moviebuzzspd@gmail.com
SMTP_PASSWORD=Password@123
EMAILS_FROM=moviebuzzspd@gmail.com
FRONTEND_URL=http://localhost:5173

# File uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads
